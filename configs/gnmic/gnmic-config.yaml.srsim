  sros_port_stats:
    paths:
    - /state/port[port-id=1/1/c1/1]/ethernet/statistics/out-octets
    - /state/port[port-id=1/1/c2/1]/ethernet/statistics/out-octets
    - /state/port[port-id=1/1/c3/1]/ethernet/statistics/out-octets
    - /state/port[port-id=1/1/c4/1]/ethernet/statistics/out-octets
    - /state/port[port-id=1/1/c5/1]/ethernet/statistics/out-octets
    - /state/port[port-id=1/1/c6/1]/ethernet/statistics/out-octets
    - /state/port[port-id=1/1/c1/1]/ethernet/statistics/in-octets
    - /state/port[port-id=1/1/c2/1]/ethernet/statistics/in-octets
    - /state/port[port-id=1/1/c3/1]/ethernet/statistics/in-octets
    - /state/port[port-id=1/1/c4/1]/ethernet/statistics/in-octets
