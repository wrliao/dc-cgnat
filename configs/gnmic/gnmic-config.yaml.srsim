username: admin
password: NokiaSros1! 
insecure: true
port: 57400
timeout: 10s
#skip-verify: true
#encoding: bytes 
encoding: json_ietf
#debug: true

common_srl_subscriptions: &common_srl_subs
  port: 57400
  skip-verify: true
  insecure: false 
  password: NokiaSrl1!
  subscriptions:
  - srl_if_oper_state
  - srl_net_instance
  - srl_if_stats 
  - srl_if_traffic_rate
  - srl_bgp_stats
  - srl_cpu
  - srl_mem
  - srl_ipv4_routes
  - srl_ipv6_routes
  - srl_apps

targets:
  clab-srv6-srsim-core1:57400: 
    name: clab-srv6-srsim-core1
    subscriptions: &common_sros_subs
    - sros_port_oper_state
    - sros_port_stats
    - sros_if_ip_stats
    - sros_if_v4_stats
    - sros_if_v6_stats
    - sros_srpolicy_egress_stats
    - sros_if_oper_stats
    - sros_pxc_stats
    - sros_cpu
    - sros_mem
    - sros_bgp_ipv4_routes
    - sros_bgp_ipv6_routes
  clab-srv6-srsim-core2:57400: 
    name: clab-srv6-srsim-core2
    subscriptions: *common_sros_subs
  clab-srv6-srsim-core3:57400: 
    name: clab-srv6-srsim-core3
    subscriptions: *common_sros_subs
  clab-srv6-srsim-core5:57400: 
    name: clab-srv6-srsim-core5
    subscriptions: *common_sros_subs
  clab-srv6-srsim-core6:57400: 
    name: clab-srv6-srsim-core6
    subscriptions: *common_sros_subs
  clab-srv6-srsim-srv6-pe1:57400: 
    name: clab-srv6-srsim-srv6-pe1
    subscriptions: *common_sros_subs
  clab-srv6-srsim-srv6-pe2:57400: 
    name: clab-srv6-srsim-srv6-pe2
    subscriptions: *common_sros_subs
  clab-srv6-srsim-srv6-gw1:57400: 
    name: clab-srv6-srsim-srv6-gw1
    subscriptions: *common_sros_subs
  clab-srv6-srsim-srv6-gw2:57400: 
    name: clab-srv6-srsim-srv6-gw2
    subscriptions: *common_sros_subs
  clab-srv6-srsim-mpls-pe1:57400: 
    name: clab-srv6-srsim-mpls-pe1
    subscriptions: *common_sros_subs
  clab-srv6-srsim-mpls-pe2:57400: 
    name: clab-srv6-srsim-mpls-pe2
    subscriptions: *common_sros_subs
  clab-srv6-srsim-ce1:57400: 
    name: clab-srv6-srsim-ce1
    subscriptions: *common_sros_subs
  clab-srv6-srsim-ce2:57400: 
    name: clab-srv6-srsim-ce2
    subscriptions: *common_sros_subs
  clab-srv6-srsim-ce3:57400: 
    name: clab-srv6-srsim-ce3
