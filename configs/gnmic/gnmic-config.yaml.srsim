      - /state/port[port-id=1/1/c4/1]/oper-state
      - /state/port[port-id=1/1/c5/1]/oper-state
      - /state/port[port-id=1/1/c6/1]/oper-state
    mode: stream
    stream-mode: sample
    sample-interval: 5s

  sros_if_oper_state:
    paths:
    - /state/router[router-name=*]/interface[interface-name=*]/oper-state
    mode: stream
    stream-mode: sample
    sample-interval: 10s

  sros_ies_instance_oper_state:
    paths:
      - /state/service/ies[service-name=*]/oper-state
    mode: stream
    stream-mode: sample
    sample-interval: 10s

  sros_vprn_instance_oper_state:
    paths:
      - /state/service/vprn[service-name=*]/oper-state
    mode: stream
    stream-mode: sample
    sample-interval: 10s

  sros_epipe_instance_oper_state:
    paths:
      - /state/service/epipe[service-name=*]/oper-state
    mode: stream
    stream-mode: sample
    sample-interval: 10s

  sros_vpls_instance_oper_state:
    paths:
      - /state/service/vpls[service-name=*]/oper-state
    mode: stream
    stream-mode: sample
    sample-interval: 10s

  sros_vpls_instance_oper_service_id:
    paths:
      - /state/service/vpls[service-name=*]/oper-service-id
    mode: stream
    stream-mode: sample
    sample-interval: 10s

#  sros_vpls_instance_vxlan:
#    paths:
#      - /state/service/vpls[service-name=*]/vxlan
#    mode: stream
#    stream-mode: sample
#    sample-interval: 10s

